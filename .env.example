# ============================================
# ProNax Environment Configuration
# Copy this file to .env and fill in your credentials
# ============================================

# License Configuration (REQUIRED)
# Generate a valid license key using the provided license generation script
# Contact support@pronax.com for license key generation assistance
VITE_LICENSE_KEY=your_generated_license_key_here
LICENSE_SECRET=your_license_secret_key_here

# Application Configuration
APP_NAME=ProNax
APP_URL=http://localhost:5173
SUPPORT_EMAIL=support@pronax.com
APP_ENVIRONMENT=development

# Encryption Configuration (REQUIRED for secure credential storage)
# Generate a strong encryption key: openssl rand -base64 32
APP_ENCRYPTION_KEY=your_strong_encryption_key_here_generate_with_openssl_rand_base64_32

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Storage Configuration
STORAGE_PROVIDER=local
# Options: local, r2, s3

# Cloudflare R2 Configuration (for R2 storage)
# NOTE: VITE_R2_SECRET_ACCESS_KEY should NEVER be used - secrets belong server-side only
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pronax-videos
R2_PUBLIC_URL=https://your-bucket.r2.dev

# AWS S3 Configuration (for S3 storage)
S3_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# Local Storage Configuration
LOCAL_UPLOAD_PATH=./uploads
LOCAL_PUBLIC_URL=/uploads

# Live Streaming Configuration
STREAMING_ENABLED=false
STREAMING_PROVIDER=mux
RTMP_URL=rtmps://global-live.mux.com:443/app
MUX_PLAYBACK_ID=your_mux_playback_id

# Copyright Detection Configuration
COPYRIGHT_DETECTION_ENABLED=true
VITE_AUDIO_FINGERPRINT_URL=http://localhost:8000
AUDIO_FINGERPRINT_URL=http://localhost:8000
COPYRIGHT_DETECTION_THRESHOLD=75

# Python Services Database Configuration (for copyright detection)
PYTHON_DB_HOST=your_supabase_db_host
PYTHON_DB_USER=your_supabase_db_user
PYTHON_DB_PASSWORD=your_supabase_db_password
PYTHON_DB_NAME=your_supabase_db_name
PYTHON_DB_PORT=5432
PYTHON_FINGERPRINT_LIMIT=-1

# FFmpeg Configuration (for audio extraction from videos)
FFMPEG_PATH=E:\Pro Nax\ffmpeg\bin\ffmpeg.exe

# Payment Processing Configuration
PAYMENTS_ENABLED=false
VITE_STRIPE_PUBLIC_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Feature Limits
MAX_VIDEO_SIZE_MB=2048
MAX_VIDEO_DURATION_SECONDS=3600
ALLOWED_VIDEO_FORMATS=mp4,webm,mov,mkv
MAX_IMAGE_SIZE_MB=8
COPYRIGHT_CHECK_SIZE_LIMIT_MB=25

# Security Configuration
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CORS_ENABLED=true

# Development Override (NEVER set to true in production)
VITE_DEV_ADMIN_OVERRIDE=false

# ============================================
# Local LLM Configuration (for AI Agent)
# ============================================
# Choose your LLM provider: ollama, openai, groq, custom
LLM_PROVIDER=ollama

# Ollama Configuration (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Available models: llama3, mistral, codellama, phi3, etc.
# Install models with: ollama pull <model_name>

# OpenAI Configuration (alternative to Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
# Available models: gpt-4, gpt-3.5-turbo, etc.

# Groq Configuration (fast LLM via Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/llama3-70b-8192
# Available models: groq/llama3-70b-8192, groq/llama3-8b-8192, groq/mixtral-8x7b-32768
# Get API key from: https://console.groq.com/keys

# Custom LLM Configuration
CUSTOM_LLM_ENDPOINT=your_custom_llm_endpoint
CUSTOM_LLM_API_KEY=your_custom_api_key

# ============================================
# Development Notes
# ============================================
# 
# 1. Supabase Setup:
#    - Create project at https://supabase.com
#    - Get project URL from project settings
#    - Get anon key from API settings
#    - Generate service role key for server-side operations
#
# 2. Cloudflare R2 Setup (for production):
#    - Create R2 bucket in Cloudflare dashboard
#    - Generate API token with R2 permissions
#    - Configure CORS for your domain
#
# 3. Copyright Detection Service:
#    - Install Python dependencies: cd python-services && pip install -r requirements.txt
#    - Start service: python fastapi_server.py
#    - Service will run on http://localhost:8000 by default
#
# 4. Live Streaming (optional):
#    - Create Mux account for streaming
#    - Configure RTMP endpoint
#    - Set up playback IDs
#
# 5. Payment Processing (optional):
#    - Create Stripe account
#    - Get publishable and secret keys
#    - Configure webhooks
#
# ============================================
